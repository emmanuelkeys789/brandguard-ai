# =========================================================================
# BrandGuard AI — Supabase Cloud Database Configuration
# =========================================================================
# 1. Sign up for a free Supabase project at https://supabase.com
# 2. In your Supabase Dashboard, navigate to: Project Settings -> API
# 3. Copy your "Project URL" and public "anon" key into the placeholders below:

VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-api-key-here

# 4. In Supabase Dashboard -> SQL Editor, run the script in: supabase/schema.sql
#
# NOTE: BrandGuard AI automatically falls back to offline LocalStorage mode
# when these variables are not configured. No data is lost and existing workflows
# continue functioning immediately.

# =========================================================================
# BrandGuard AI — Server-Side AI & Multimodal Review Configuration
# =========================================================================
# CRITICAL SECURITY NOTE:
# NEVER prefix backend API keys with VITE_!
# These keys are strictly SERVER-SIDE credentials used by Netlify Functions v2
# (netlify/functions/*), Vercel Serverless Functions, or Vite dev server proxy.
# They must NEVER be bundled into client code.

# OpenAI Configuration (Vision & Tone):
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o-mini
# OPENAI_BASE_URL=https://api.openai.com/v1

# Google Gemini Configuration (Multimodal Vision & Tone):
# GEMINI_API_KEY=your_gemini_api_key_here
# GOOGLE_API_KEY=your_google_api_key_here
# GEMINI_MODEL=gemini-1.5-flash
# MULTIMODAL_PROVIDER=gemini # Optional: 'gemini' | 'openai' (defaults to gemini when GEMINI_API_KEY is present)

# =========================================================================
# BrandGuard AI — Server-Side Enterprise Publishing Webhook Configuration
# =========================================================================
# Used by POST /api/publish for authorized, signed downstream dispatches.
# PUBLISHING_WEBHOOK_ENABLED=true
# PUBLISHING_WEBHOOK_URL=https://your-cms.example.com/api/webhooks/publish
# PUBLISHING_WEBHOOK_SECRET=your_hmac_sha256_signing_secret_here

# =========================================================================
# BrandGuard AI — Server-Side Authoritative Verification (Supabase)
# =========================================================================
# Used strictly on the server for token verification and user_roles lookup.
# SUPABASE_URL=https://your-project-id.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=your-secret-service-role-key-here

# NOTE: If no AI or webhook credentials are provided, BrandGuard AI safely reports
# status: 'unavailable', preserves all deterministic rule checking, and allows
# drafts and demo publishing simulations to proceed without error or fake results.

